# Large binary documents are stored via Git LFS.
*.pdf filter=lfs diff=lfs merge=lfs -text

# Figure-research history is intentionally preserved, including failed and
# intermediate raster outputs. Keep that evidence out of ordinary Git object
# storage while retaining it in the repository history.
history/figures/**/*.png filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.jpg filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.webp filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.tif filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.tiff filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.npy filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.npz filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.tar filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.tgz filter=lfs diff=lfs merge=lfs -text
history/figures/**/*.zip filter=lfs diff=lfs merge=lfs -text
